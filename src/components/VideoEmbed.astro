---
/**
 * The article's video as a click-to-play poster. Nothing loads from YouTube until the reader presses
 * play; then the poster is swapped for a youtube-nocookie player. Without JS, the poster links to
 * the video on YouTube.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { SERIES } from '../data/categories';

interface Props {
  id: string;
  duration: string;
  title: string;
  slug: string;
}
const { id, duration, title, slug } = Astro.props;

const thumbs = import.meta.glob<{ default: ImageMetadata }>('../assets/video/*.{png,jpg}', { eager: true });
const thumb = Object.entries(thumbs).find(([path]) => path.includes(`/${slug}.`))?.[1].default;
const watch = `https://www.youtube.com/watch?v=${id}`;
const [m, s] = duration.split(':');
const spoken = `${m} min ${Number(s)} s`;
---

<figure class="video" data-video={id} data-video-title={title} data-pagefind-ignore>
  <div class="video-frame">
    <a class="video-play" href={watch} aria-label={`Play ${duration} video: ${title}`}>
      {
        thumb ? (
          <Image src={thumb} alt="" widths={[480, 800, 1280]} sizes="(min-width: 760px) 720px, 100vw" loading="eager" />
        ) : (
          <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" />
        )
      }
      <!-- Bottom right, where YouTube thumbnails keep clear for the duration badge. -->
      <span class="play-btn" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" /></svg>
        {duration}
      </span>
    </a>
  </div>
  <figcaption>
    <span class="video-label"><Icon name="play" size={18} /> Video version, {spoken}</span>
    <a href={watch}>Watch on YouTube</a>
    <a href={SERIES.playlist}>{SERIES.name} playlist</a>
  </figcaption>
</figure>

<style>
  .video {
    margin: 0 0 2rem;
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #060d1f;
  }

  .video-play {
    position: absolute;
    inset: 0;
    display: block;
  }

  .video-play :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .video-play:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }

  .play-btn {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0 0.9rem 0 0.7rem;
    border-radius: 999px;
    background: rgb(6 13 31 / 0.88);
    border: 2px solid #38bdf8;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 20px rgb(56 189 248 / 0.4);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  /* Small screens: the whole poster is the touch target, so the badge can shrink off the artwork. */
  @media (max-width: 520px) {
    .play-btn {
      right: 0.4rem;
      bottom: 0.4rem;
      min-height: 30px;
      padding: 0 0.6rem 0 0.45rem;
      font-size: 0.8rem;
      border-width: 1.5px;
    }
    .play-btn svg {
      width: 16px;
      height: 16px;
    }
  }

  .video-play:hover .play-btn,
  .video-play:focus-visible .play-btn {
    background: #0b5fd6;
    transform: scale(1.06);
  }

  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  figcaption a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-weight: 600;
  }

  .video-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-right: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .play-btn {
      transition: none;
    }
  }
</style>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-video]')) {
    const link = fig.querySelector<HTMLAnchorElement>('.video-play');
    link?.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // open on YouTube instead
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${fig.dataset.video}?autoplay=1&rel=0`;
      iframe.title = fig.dataset.videoTitle ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      link.replaceWith(iframe);
      iframe.focus();
    });
  }
</script>
