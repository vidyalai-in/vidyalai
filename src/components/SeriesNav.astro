---
import Icon from './Icon.astro';
import { postUrl, type Post } from '../lib/posts';

interface Props {
  prev?: Post;
  next?: Post;
}
const { prev, next } = Astro.props;
---

<nav class="series-nav" aria-label="Series navigation" data-pagefind-ignore>
  {
    prev ? (
      <a class="sn sn-prev" href={postUrl(prev)} rel="prev">
        <span class="sn-dir"><Icon name="arrowLeft" size={18} /> Previous: Part {prev.data.seriesOrder}</span>
        <span class="sn-title">{prev.data.title}</span>
      </a>
    ) : <span />
  }
  {
    next && (
      <a class="sn sn-next" href={postUrl(next)} rel="next">
        <span class="sn-dir">Next: Part {next.data.seriesOrder} <Icon name="arrowRight" size={18} /></span>
        <span class="sn-title">{next.data.title}</span>
      </a>
    )
  }
</nav>

<style>
  .series-nav {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-top: 3rem;
  }

  @media (min-width: 640px) {
    .series-nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sn {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: var(--text-strong);
  }

  .sn:hover {
    border-color: var(--accent);
  }

  .sn-next {
    text-align: right;
    grid-column: -2;
  }

  .sn-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .sn-next .sn-dir {
    justify-content: flex-end;
  }

  .sn-title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.3;
  }
</style>
