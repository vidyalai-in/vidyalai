---
import Base from '../../layouts/Base.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { SERIES } from '../../data/series.mjs';
import { getPosts } from '../../lib/posts';
import { numberWord } from '../../lib/words';

const posts = await getPosts();
---

<Base title="Series" description={`${numberWord(SERIES.length)} article series on large language models: how they work, the math behind them, how to train one, what happens inside one, how inference is made fast, how they run on GPUs, how models handle images, speech and video, how to measure them with evals and benchmarks, how to design production systems with them, and how AI agents work.`}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Series</p>
      <h1>Learn LLMs in order</h1>
      <p>
        Start with the fundamentals and the math behind them, train a small model yourself, look inside it to see what it learned, move on to how models are
        served fast and how they run on GPUs, see how models handle images, speech and video, learn what a benchmark score really tells you, then design real systems and agents with them. Each
        series reads in order, and every article also stands on its own.
      </p>
    </header>
    <ul class="card-grid">
      {
        SERIES.map((s) => (
          <li>
            <SeriesCard series={s} published={posts.filter((p) => p.data.series === s.slug).length} headingLevel="h2" />
          </li>
        ))
      }
    </ul>
  </div>
</Base>
