---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import Icon from '../components/Icon.astro';
import banner from '../assets/brand/banner1.png';
import bannerMobile from '../assets/brand/banner-mobile.png';
import { CATEGORIES } from '../data/categories';
import { SERIES, getSeries } from '../data/series.mjs';
import { getPosts } from '../lib/posts';
import { numberWord } from '../lib/words';

const posts = await getPosts();
// The first part of each series.
const featuredSlugs = ['what-is-an-ai-agent', 'build-llm-from-scratch', 'how-llms-work', 'math-for-llms', 'how-llm-inference-works', 'gpu-from-python-to-silicon', 'rag-system-10m-documents'];
const featured = featuredSlugs.map((slug) => posts.find((p) => p.id === slug)).filter((p) => p !== undefined);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.slug, posts.filter((p) => p.data.category === c.slug).length]));

// Art direction: wide banner from 768px, a centred crop (logo, tagline, icons) on phones.
const wide = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: banner, format, widths: [960, 1440, 1983], sizes: '(min-width: 1440px) 1376px, 100vw' })),
);
const narrow = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: bannerMobile, format, widths: [480, 720, 900], sizes: '100vw' })),
);
const fallback = await getImage({ src: banner, format: 'jpg', width: 1440 });
---

<Base title="VidyalAI" description="Clear, sourced deep dives on large language models: how they work, how inference is made fast, and how to design production systems with them.">
  <section class="hero">
    <div class="container">
      <picture class="hero-banner">
        {narrow.map((img) => <source media="(max-width: 767px)" type={`image/${img.options.format}`} srcset={img.srcSet.attribute} sizes="100vw" />)}
        {wide.map((img) => <source type={`image/${img.options.format}`} srcset={img.srcSet.attribute} sizes={img.attributes.sizes} />)}
        <img
          src={fallback.src}
          width={banner.width}
          height={banner.height}
          alt="VidyalAI: Knowledge Amplified. An open book releasing glowing icons for AI, science and skills, beside a digital human profile. People + ideas + AI = a brighter tomorrow."
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="hero-copy">
        <p class="eyebrow">New: {getSeries('agentic-ai').name} and {getSeries('llm-from-scratch').name}</p>
        <h1>Understand LLMs, from attention to production</h1>
        <p class="hero-lede">
          {posts.length} in-depth articles in {numberWord(SERIES.length).toLowerCase()} series: how large language models work and the math
          behind them, how to train one, how they generate text fast and run on GPUs, how to build systems that hold up in
          production, and how AI agents work. Each one explains the idea, works
          through the numbers, and links the sources to check.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/series/">
            Browse the series <Icon name="arrowRight" size={18} />
          </a>
          <a class="btn btn-ghost" href="/category/">Browse topics</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="series-heading">
    <div class="section-head">
      <div>
        <h2 id="series-heading">{numberWord(SERIES.length)} series</h2>
        <p>Each reads in order, from the first part to the last. Every article also stands on its own.</p>
      </div>
      <a href="/series/">All series <Icon name="arrowRight" size={16} /></a>
    </div>
    <ul class="card-grid">
      {SERIES.map((s) => <li><SeriesCard series={s} published={posts.filter((p) => p.data.series === s.slug).length} /></li>)}
    </ul>
  </section>

  <section class="container section" aria-labelledby="featured-heading">
    <div class="section-head">
      <div>
        <h2 id="featured-heading">Start here</h2>
        <p>The first part of each series.</p>
      </div>
      <a href="/blog/">All articles <Icon name="arrowRight" size={16} /></a>
    </div>
    <ul class="card-grid">
      {featured.map((p) => <li><PostCard post={p} /></li>)}
    </ul>
  </section>

  <section class="container section topics" aria-labelledby="topics-heading">
    <div class="section-head">
      <div>
        <h2 id="topics-heading">Explore by topic</h2>
        <p>{numberWord(CATEGORIES.length)} areas, from what happens inside a model to what it takes to run one for real traffic.</p>
      </div>
    </div>
    <ul class="card-grid">
      {CATEGORIES.map((c) => <li><CategoryCard category={c} count={counts[c.slug]} /></li>)}
    </ul>
  </section>

</Base>

<style>
  .hero {
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .hero-banner img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: clamp(12px, 2vw, 20px);
    border: 1px solid var(--border);
    box-shadow: 0 0 0 1px rgb(56 189 248 / 0.08), 0 20px 60px -20px rgb(30 123 255 / 0.45);
    background: #07142c;
  }

  .hero-copy {
    max-width: 52rem;
    margin: clamp(1.75rem, 4vw, 3rem) auto 0;
    text-align: center;
  }

  .hero-copy h1 {
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    margin: 0 0 1rem;
    font-weight: 800;
  }

  .hero-lede {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--muted);
    margin: 0 auto 1.75rem;
    max-width: 44rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .section-head > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
    min-height: 44px;
  }
</style>
