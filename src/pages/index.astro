---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Icon from '../components/Icon.astro';
import banner from '../assets/brand/banner1.png';
import bannerMobile from '../assets/brand/banner-mobile.png';
import { CATEGORIES, SERIES, getCategory } from '../data/categories';
import { getPosts, postUrl } from '../lib/posts';

const posts = await getPosts();
const featuredOrders = [1, 6, 25];
const featured = featuredOrders
  .map((n) => posts.find((p) => p.data.seriesOrder === n))
  .filter((p) => p !== undefined);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.slug, posts.filter((p) => p.data.category === c.slug).length]));

// Art direction: wide banner from 768px, a centred crop (logo, tagline, icons) on phones.
const wide = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: banner, format, widths: [960, 1440, 1983], sizes: '(min-width: 1440px) 1376px, 100vw' })),
);
const narrow = await Promise.all(
  (['avif', 'webp'] as const).map((format) => getImage({ src: bannerMobile, format, widths: [480, 720, 900], sizes: '100vw' })),
);
const fallback = await getImage({ src: banner, format: 'jpg', width: 1440 });
---

<Base title="VidyalAI" description="Clear, sourced deep dives on designing production LLM systems: RAG, evaluation, agents, serving, security and operations.">
  <section class="hero">
    <div class="container">
      <picture class="hero-banner">
        {narrow.map((img) => <source media="(max-width: 767px)" type={`image/${img.options.format}`} srcset={img.srcSet.attribute} sizes="100vw" />)}
        {wide.map((img) => <source type={`image/${img.options.format}`} srcset={img.srcSet.attribute} sizes={img.attributes.sizes} />)}
        <img
          src={fallback.src}
          width={banner.width}
          height={banner.height}
          alt="VidyalAI: Knowledge Amplified. An open book releasing glowing icons for AI, science and skills, beside a digital human profile. People + ideas + AI = a brighter tomorrow."
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="hero-copy">
        <p class="eyebrow">New series · {SERIES.name}</p>
        <h1>Build LLM systems that hold up in production</h1>
        <p class="hero-lede">
          {posts.length} in-depth articles on retrieval, evaluation, agents, serving, security and operations. Each one gives you the
          design, the numbers that size it, the ways it fails, and the sources to check.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="/series/llm-system-design/">
            Start the series <Icon name="arrowRight" size={18} />
          </a>
          <a class="btn btn-ghost" href="/category/">Browse topics</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="featured-heading">
    <div class="section-head">
      <div>
        <h2 id="featured-heading">Start here</h2>
        <p>Three articles that cover the ground most LLM products stand on.</p>
      </div>
      <a href="/blog/">All articles <Icon name="arrowRight" size={16} /></a>
    </div>
    <ul class="card-grid">
      {featured.map((p) => <li><PostCard post={p} /></li>)}
    </ul>
  </section>

  <section class="container section topics" aria-labelledby="topics-heading">
    <div class="section-head">
      <div>
        <h2 id="topics-heading">Explore by topic</h2>
        <p>Seven areas you need to get right before an LLM feature is ready for real traffic.</p>
      </div>
    </div>
    <ul class="card-grid">
      {CATEGORIES.map((c) => <li><CategoryCard category={c} count={counts[c.slug]} /></li>)}
    </ul>
  </section>

  <section class="container section" aria-labelledby="series-heading">
    <div class="section-head">
      <div>
        <h2 id="series-heading">The full reading order</h2>
        <p>{SERIES.blurb}</p>
      </div>
    </div>
    <ol class="series-grid">
      {
        posts.map((p) => (
          <li>
            <a href={postUrl(p)}>
              <span class="num">{String(p.data.seriesOrder).padStart(2, '0')}</span>
              <span class="t">
                <span class="title">{p.data.title}</span>
                <span class="cat">{getCategory(p.data.category).name}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .hero-banner img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: clamp(12px, 2vw, 20px);
    border: 1px solid var(--border);
    box-shadow: 0 0 0 1px rgb(56 189 248 / 0.08), 0 20px 60px -20px rgb(30 123 255 / 0.45);
    background: #07142c;
  }

  .hero-copy {
    max-width: 52rem;
    margin: clamp(1.75rem, 4vw, 3rem) auto 0;
    text-align: center;
  }

  .hero-copy h1 {
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    margin: 0 0 1rem;
    font-weight: 800;
  }

  .hero-lede {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--muted);
    margin: 0 auto 1.75rem;
    max-width: 44rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .section-head > a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
    min-height: 44px;
  }

  .series-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .series-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .series-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .series-grid a {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 0.75rem 0.9rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-strong);
  }

  .series-grid a:hover {
    border-color: var(--border);
    background: var(--surface);
  }

  .num {
    flex: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--accent);
    min-width: 2ch;
  }

  .t {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .title {
    font-weight: 600;
    line-height: 1.35;
  }

  .cat {
    font-size: 0.82rem;
    color: var(--muted);
  }
</style>
