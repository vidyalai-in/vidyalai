  end
  subgraph EP["Expert parallelism: spread the experts"]
    direction TB
    A["Home GPU<br/>attention + router"]
    E1["GPU 2<br/>experts 129-256"]
    E2["GPU 1<br/>experts 1-128"]
    C["Home GPU<br/>adds expert outputs"]
    A -->|"dispatch"| E1
    A -->|"dispatch"| E2
    E1 -->|"combine"| C
    E2 -->|"combine"| C
  end
