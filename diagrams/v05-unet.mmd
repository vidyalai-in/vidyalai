    U3 --> U2["14 × 14 × 64<br/>3 res blocks"]
    U2 --> U1["28 × 28 × 32<br/>3 res blocks"]
    U1 --> O["Predicted noise<br/>28 × 28 × 1"]
    D1 -. "skip" .-> U1
    D2 -. "skip" .-> U2
    D3 -. "skip" .-> U3
